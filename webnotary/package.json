{
  "name": "webnotary",
  "version": "0.1.0",
  "description": "Navegador forense para registro de sessões web (WhatsApp Web, sites, mídias) com gravação de vídeo real, hash, manifesto assinado ICP-Brasil e carimbo do tempo. Finalidade notarial/jurídica.",
  "main": "src/main/main.js",
  "author": "Perito Bruno Ferrari",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke-electron.js",
    "verify": "node cli/webnotary-verify.js",
    "server": "node server/verify-server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@signpdf/placeholder-plain": "^3.2.4",
    "@signpdf/signpdf": "^3.3.0",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.15.0"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.7"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.peritobrunoferrari.webnotary",
    "productName": "WebNotary",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" },
    "mac": { "target": ["dmg"] }
  }
}
